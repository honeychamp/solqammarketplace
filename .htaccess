# Redirect all web traffic into public/ (cPanel / LiteSpeed when document root is public_html)
<IfModule mod_rewrite.c>
	RewriteEngine On

	# www → apex before rewriting into public/ (otherwise URL becomes /public/...)
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

	# Serve real files from public/ (product photos, CSS) so LiteSpeed does not 404 via index.php
	RewriteCond %{REQUEST_URI} !^/public/
	RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
	RewriteRule ^ public%{REQUEST_URI} [L]

	RewriteCond %{REQUEST_URI} !^/public/
	RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.env">
	<IfModule authz_core_module>
		Require all denied
	</IfModule>
	<IfModule !authz_core_module>
		Deny from all
	</IfModule>
</FilesMatch>
